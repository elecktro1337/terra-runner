{
  "schemaVersion": 2,
  "openCodeCommand": "opencode",
  "agent": "build",
  "model": "openai/gpt-5.6-terra",
  "projects": [
    {
      "id": "ntd-terra",
      "path": "D:\\Cloud\\Разработка\\Сайты\\Проекты\\erranix.agency\\ntd-terra",
      "branch": "codex/terra",
      "roadmap": "NTD-ROADMAP.md",
      "progress": "NTD-PROGRESS.md"
    }
  ],
  "budget": {
    "mode": "daily",
    "dailyUsd": 5.0,
    "reserveUsd": 0.5,
    "emergencyStopUsd": 4.95,
    "allowUnlimited": false,
    "requireGlobalOpenCodeStats": true,
    "stopOnZeroCostWithTokens": true,
    "balance": {
      "source": "snapshot",
      "id": "openai-main-account",
      "minimumUsd": 5.0,
      "iterationReserveUsd": 0.5,
      "maxAgeMinutes": 5,
      "command": "",
      "arguments": []
    }
  },
  "execution": {
    "pollSeconds": 20,
    "maxIterationMinutes": 45,
    "maxIterationsPerRun": 500,
    "maxConsecutiveNoProgress": 3,
    "maxConsecutiveDocumentationOnly": 12,
    "maxToolErrorsPerIteration": 15,
    "pauseBetweenIterationsSeconds": 3,
    "maxRawLogMiB": 80
  },
  "logs": {
    "root": "./data/projects",
    "retainDays": 21,
    "maxIterationsPerProject": 150,
    "maxTotalMiBPerProject": 300,
    "reportRetainDays": 60
  }
}
